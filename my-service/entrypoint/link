#!/bin/bash
# Runs workflows/<action>.yaml for a link action: create -> link, update -> link-update, delete -> unlink.
set -euo pipefail

case "$SERVICE_ACTION_TYPE" in
  create) action="link" ;;
  update) action="link-update" ;;
  delete) action="unlink" ;;
  custom) action="$SERVICE_ACTION" ;;
  *) action="$SERVICE_ACTION_TYPE" ;;
esac

echo "Executing link action=$SERVICE_ACTION type=$SERVICE_ACTION_TYPE"
np service workflow exec --workflow "$SERVICE_PATH/workflows/$action.yaml" --values "$SERVICE_PATH/values.yaml"
